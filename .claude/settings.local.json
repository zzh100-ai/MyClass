  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Write|Edit|Read",
        "hooks": [
          {
            "type": "command",
            "command": "python .claude/hooks/read-task-plan.py",
            "timeout": 5,
            "statusMessage": "读取任务计划..."
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python C:/Users/zhangziheng/.claude/plugins/cache/planning-with-files/planning-with-files/2.35.0/scripts/session-catchup.py \"$PWD\"",
            "timeout": 10,
            "statusMessage": "恢复上次会话上下文..."
          }
        ]
      }
    ]
  }
}
